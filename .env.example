# Obsidian Vault Configuration
# Copy this file to .env and fill in your vault path

# REQUIRED: Path to your Obsidian vault directory
# - For local development: use absolute path to your vault
#   Example: /Users/yourname/Documents/ObsidianVault
# - For Docker: this will be the host path that gets mounted to /vault
#   Example: ./vault (relative to docker-compose.yml)
#   Example: /absolute/path/to/your/vault
VAULT_PATH=./vault
