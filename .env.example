# Obsidian Local REST API Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Your Obsidian Local REST API key
# Get this from Obsidian > Settings > Community Plugins > Local REST API
OBSIDIAN_API_KEY=your-api-key-here

# Host where Obsidian REST API is running
# - If Obsidian is on your host machine: use 'host.docker.internal' (Docker Desktop) or '172.17.0.1' (Linux)
# - If Obsidian is on another machine: use that machine's IP address
# - If using network_mode: host in docker-compose: use 'localhost' or '127.0.0.1'
OBSIDIAN_HOST=host.docker.internal

# Port for Obsidian REST API (default: 27124)
OBSIDIAN_PORT=27124

# Protocol: http or https (default: https)
OBSIDIAN_PROTOCOL=https
